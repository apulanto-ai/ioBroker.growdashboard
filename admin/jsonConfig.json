{
  "type": "tabs",
  "items": {
    "tab_general": {
      "type": "tab",
      "label": "Allgemein",
      "items": {
        "grafanaUrl": {
          "type": "text",
          "label": "Grafana URL",
          "placeholder": "http://localhost:3000",
          "sm": 12,
          "md": 6
        },
        "grafanaToken": {
          "type": "password",
          "label": "Grafana API Token",
          "sm": 12,
          "md": 6
        }
      }
    },
    "tab_ventilation": {
      "type": "tab",
      "label": "Lueftung",
      "items": {
        "_header_sensors": {
          "type": "header",
          "text": "Sensoren (Eingang)",
          "size": 5
        },
        "ventTempId": {
          "type": "objectId",
          "label": "Temperatur-State",
          "sm": 12,
          "md": 4,
          "filter": {
            "type": "state",
            "common": { "type": "number" }
          }
        },
        "ventHumId": {
          "type": "objectId",
          "label": "Luftfeuchtigkeit-State",
          "sm": 12,
          "md": 4,
          "filter": {
            "type": "state",
            "common": { "type": "number" }
          }
        },
        "ventFanReadId": {
          "type": "objectId",
          "label": "Lueftergeschwindigkeit (Istwert)",
          "sm": 12,
          "md": 4,
          "filter": {
            "type": "state",
            "common": { "type": "number" }
          }
        },
        "_header_control": {
          "type": "header",
          "text": "Steuerung (Ausgang)",
          "size": 5
        },
        "ventFanWriteId": {
          "type": "objectId",
          "label": "Lueftersteuerung (Sollwert schreiben)",
          "sm": 12,
          "md": 6,
          "filter": {
            "type": "state",
            "common": { "type": "number" }
          }
        },
        "_header_thresholds": {
          "type": "header",
          "text": "Schwellenwerte",
          "size": 5
        },
        "ventTempMin": {
          "type": "number",
          "label": "Temperatur Min (C)",
          "sm": 12,
          "md": 3,
          "default": 18
        },
        "ventTempMax": {
          "type": "number",
          "label": "Temperatur Max (C)",
          "sm": 12,
          "md": 3,
          "default": 28
        },
        "ventHumMin": {
          "type": "number",
          "label": "Luftfeuchtigkeit Min (%)",
          "sm": 12,
          "md": 3,
          "default": 50
        },
        "ventHumMax": {
          "type": "number",
          "label": "Luftfeuchtigkeit Max (%)",
          "sm": 12,
          "md": 3,
          "default": 70
        }
      }
    },
    "tab_dashboard": {
      "type": "tab",
      "label": "Dashboard",
      "items": {
        "_header_tiles": {
          "type": "header",
          "text": "ioBroker Datenpunkte (Kacheln)",
          "size": 5
        },
        "dashboardTiles": {
          "type": "table",
          "label": "Kacheln",
          "showSecondAddAt": 5,
          "items": {
            "stateId": {
              "type": "objectId",
              "label": "State ID",
              "width": "35%",
              "filter": { "type": "state" }
            },
            "label": {
              "type": "text",
              "label": "Bezeichnung",
              "width": "25%"
            },
            "unit": {
              "type": "text",
              "label": "Einheit",
              "width": "10%"
            },
            "decimals": {
              "type": "number",
              "label": "Nachkommastellen",
              "width": "10%",
              "default": 1
            },
            "color": {
              "type": "color",
              "label": "Farbe",
              "width": "10%"
            },
            "enabled": {
              "type": "checkbox",
              "label": "Aktiv",
              "width": "10%",
              "default": true
            }
          }
        },
        "_header_grafana": {
          "type": "header",
          "text": "Grafana Panels",
          "size": 5
        },
        "grafanaPanels": {
          "type": "table",
          "label": "Grafana Panels",
          "showSecondAddAt": 3,
          "items": {
            "url": {
              "type": "text",
              "label": "Panel URL (embed)",
              "width": "50%",
              "placeholder": "http://grafana:3000/d-solo/..."
            },
            "title": {
              "type": "text",
              "label": "Titel",
              "width": "25%"
            },
            "height": {
              "type": "number",
              "label": "Hoehe (px)",
              "width": "15%",
              "default": 300
            },
            "enabled": {
              "type": "checkbox",
              "label": "Aktiv",
              "width": "10%",
              "default": true
            }
          }
        }
      }
    }
  }
}
